{
  "name": "TraceDesk PDF Editor",
  "short_name": "PDF Editor",
  "description": "Edit any PDF, including scans, without changing its layout: change words, add text, sign, tick, white-out and highlight.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#E9EEEA",
  "theme_color": "#14532D",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"], "image/jpeg": [".jpg", ".jpeg"], "image/png": [".png"] } }
  ]
}
